#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
        chosen {
                zephyr,pdm = &pdm20;
        };
};

&pinctrl {
        pdm20_default: pdm20_default {
                group1 {
                        psels = <NRF_PSEL(PDM_CLK, 1, 10)>;
                        nordic,drive-mode = <NRF_DRIVE_H0H1>;
                };
                group2 {
                        psels = <NRF_PSEL(PDM_DIN, 1, 11)>;
                        bias-pull-down;
                };
        };

        pdm20_sleep: pdm20_sleep {
                group1 {
                        psels = <NRF_PSEL(PDM_CLK, 1, 10)>,
                                <NRF_PSEL(PDM_DIN, 1, 11)>;
                        low-power-enable;
                };
        };

        /* UART30 mapped to P0.25 to bypass the debugger conflict */
        uart30_default: uart30_default {
                group1 {
                        psels = <NRF_PSEL(UART_RX, 0, 7)>;
                        bias-pull-up;
                };
        };

        uart30_sleep: uart30_sleep {
                group1 {
                        psels = <NRF_PSEL(UART_RX, 0, 7)>;
                        low-power-enable;
                };
        };
};

&pdm20 {
        status = "okay";
        pinctrl-0 = <&pdm20_default>;
        pinctrl-1 = <&pdm20_sleep>;
        pinctrl-names = "default", "sleep";
};

&uart30 {
        status = "okay";
        current-speed = <2400>;
        pinctrl-0 = <&uart30_default>;
        pinctrl-1 = <&uart30_sleep>;
        pinctrl-names = "default", "sleep";
};
